# FairShift environment variables. Copy to .env.local and fill in what you need.
#
# NOTHING IS REQUIRED TO RUN LOCALLY. With every value left empty:
#   - data comes from a seeded in-memory store (demo organisations, workers and shifts)
#   - sessions are signed with a fixed local-development secret
#   - AI features (payslip explanation, hazard summary, Ask FairShift) use rule-based answers
#
# All values are validated at startup by src/server/env.ts, which names any malformed variable.
# Never commit a filled-in copy of this file.

# ── Data ────────────────────────────────────────────────────
# MongoDB connection string, e.g. mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net
# An empty database is seeded with the demo data on first use. If the cluster is unreachable,
# the app logs it and keeps serving the seeded in-memory data.
MONGODB_URI=
# Database name inside the cluster. Default: fairshift
MONGODB_DB=
# Set to "memory" to force the in-memory store even when MONGODB_URI is set.
DATA_BACKEND=

# ── Security ────────────────────────────────────────────────
# Signs session cookies and derives the QR and skill-passport keys.
# REQUIRED IN PRODUCTION, at least 16 characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# ── AI (optional) ───────────────────────────────────────────
# Google Gemini API key from https://aistudio.google.com/apikey (server-only, never sent to the browser).
GEMINI_API_KEY=
# Gemini model id. Default: gemini-2.5-flash
GEMINI_MODEL=

# ── Weather (optional) ──────────────────────────────────────
# Heat-stress alerts use live weather from Open-Meteo (free, no key). Set to 1 to turn them off.
WEATHER_DISABLED=
