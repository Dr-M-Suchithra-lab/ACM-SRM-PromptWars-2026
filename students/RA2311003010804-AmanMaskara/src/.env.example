# Copy to .env.local for local development. In production, set these as Vercel environment
# variables (the live demo) or Cloud Run secrets (scripts/deploy-cloudrun.sh creates them in
# Secret Manager). Never commit real values.

# Required in production: signs session cookies (32+ random chars)
SESSION_SECRET=
# Required in production unless DEMO_MODE=true: one-way keys for anonymous feedback,
# co-signed issues and private hazard tracking references
FEEDBACK_HMAC_SECRET=
# Optional: signs QR tokens (falls back to per-site seed secrets in demo)
QR_SIGNING_SECRET=
# Optional: signs skill-passport and work-certificate links (defaults to SESSION_SECRET)
PASSPORT_SECRET=
# Optional: protects POST /api/cron/hazards (Cloud Scheduler escalation sweep)
CRON_SECRET=

# Gemini (Google AI Studio key). Without it every AI feature uses its deterministic fallback.
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-3.5-flash-lite, gemini-3.8-flash, gemini-3.8-flash-lite-tts)
GEMINI_MODEL_FAST=
GEMINI_MODEL_FALLBACK=
GEMINI_MODEL_TTS=

# true = one-tap demo logins, and the demo database is re-seeded daily relative to today
DEMO_MODE=true

# MongoDB Atlas connection string (production). Unset = in-memory demo data.
MONGODB_URI=
MONGODB_DB=fairshift
