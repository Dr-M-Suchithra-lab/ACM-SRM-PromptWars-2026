{
  "name": "shiftseal",
  "version": "1.0.0",
  "private": true,
  "description": "Shiftseal: a FairShift decent work platform (SDG 8) \u2014 Proof of work for the world's shift workers",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "start:local": "node --env-file=.env dist/server/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"tests/**/*.ts\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@firebase/app": "^0.13.2",
    "@firebase/auth": "^1.13.6",
    "@google-cloud/firestore": "^7.11.0",
    "@google/genai": "^1.0.0",
    "compression": "^1.8.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.14",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20.6"
  }
}
