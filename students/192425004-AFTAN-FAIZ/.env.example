SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
# Only needed by the one-time synthetic seed script, never by the application:
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
PORT=8080
NODE_ENV=development
# Local synthetic demo credentials. Set ENABLE_DEMO=true only in isolated demo deployments.
ENABLE_DEMO=false
DEMO_PASSWORD=
# Dedicated least-privilege Auth account. No worker/organization membership.
SAFETY_GATEWAY_EMAIL=safety.gateway@demo.fairshift.example
SAFETY_GATEWAY_PASSWORD=
# Optional distinct random HMAC secret for shared database-backed rate limits.
# If omitted, the existing gateway password remains the server-side fallback.
RATE_LIMIT_SALT=
