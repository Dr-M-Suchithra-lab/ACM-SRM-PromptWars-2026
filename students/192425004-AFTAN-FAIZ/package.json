{
  "name": "nyaveris-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:rls": "tsx scripts/rls-test.ts",
    "test:rls:readonly": "tsx scripts/rls-readonly-test.ts",
    "db:provision": "tsx scripts/provision.ts",
    "format": "prettier --write src server shared scripts tests docs *.json *.ts *.md",
    "check:security": "tsx scripts/security-check.ts"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@supabase/supabase-js": "2.99.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.3.1",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "lucide-react": "0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.1.4",
    "esbuild": "0.28.2",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
