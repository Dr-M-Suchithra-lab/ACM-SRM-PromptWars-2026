{
  "name": "fairshift",
  "version": "1.0.0",
  "private": true,
  "description": "FairShift: fair, safe and transparent work for employee-intensive organisations (UN SDG 8).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --env-file-if-exists=.env --import tsx src/server/index.ts\" \"vite\"",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "build:web": "vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:api": "esbuild src/server/vercel.ts --bundle --platform=node --format=esm --packages=external --outfile=api/_handler.mjs",
    "build:vercel": "npm run build:web && npm run build:api"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-tamil": "^5.3.0",
    "@google-cloud/firestore": "^9.4.0",
    "@google/genai": "^2.31.0",
    "@hono/node-server": "^2.1.5",
    "@upstash/redis": "^1.40.0",
    "hono": "^4.13.14",
    "preact": "^11.0.2",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
