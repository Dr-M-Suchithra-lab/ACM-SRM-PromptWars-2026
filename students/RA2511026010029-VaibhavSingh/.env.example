# FairShift Hisaab - Environment Configuration
# Target Database: MongoDB Atlas (Account: vaibhavnr06@gmail.com)
#
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env.local for local development.

# --- SESSION & ENCRYPTION ---
# 32+ character cryptographic secret for signing HTTP-only JWT cookies
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- MONGODB ATLAS CONFIGURATION ---
# Registered for: vaibhavnr06@gmail.com
# Database Name: fairshift_hisaab
#
# Standard MongoDB Connection URI:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fairshift_hisaab?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=fairshift_hisaab

# Alternative: MongoDB Atlas REST Data API (for Edge & Serverless environments)
MONGODB_DATA_API_URL=
MONGODB_DATA_API_KEY=

# --- AUTHENTICATION & DEMO MODE ---
# Set to true for frictionless demonstration with preset PINs (12345, 123456, 777888)
# In production, set to false to enforce live SMS OTP / Firebase Auth
DEMO_MODE=true

# Master Admin Security Passcode (Default demo: 123456 or 777888)
ADMIN_MASTER_PIN=123456

# --- OPTIONAL CLOUD & AI INTEGRATIONS ---
# Gemini API Key for voice note translation & OCR parsing
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# OAuth Login Providers (Optional)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
