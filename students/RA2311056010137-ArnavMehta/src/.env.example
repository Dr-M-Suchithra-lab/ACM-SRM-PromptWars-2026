# ShiftSaathi environment variables. Copy to .env and fill in what you need: cp .env.example .env
# Never commit .env or real values. On Cloud Run these come from Secret Manager instead.
#
# For a local run every value may stay empty: the app generates development keys into
# backend/.dev-secrets.json (git-ignored) and the voice and payment features say they are not set up.

# --- App --------------------------------------------------------------------------------------
# "production" makes DATA_KEY, PASSPORT_SIGNING_KEY and JWT_SECRET required and hides /docs.
APP_ENV=development

# Required in production. Each is 32 random bytes, base64-encoded:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DATA_KEY=                # AES-256-GCM key for anonymous feedback
PASSPORT_SIGNING_KEY=    # Ed25519 seed for Skill Passports
JWT_SECRET=              # signs sign-in tokens

# Only when the web app runs on another origin (e.g. `next dev` on :3000, or Vercel). Comma-separated.
ALLOWED_ORIGINS=

# --- Voice assistant (optional) ---------------------------------------------------------------
# Either a Gemini API key, or leave it empty and set a Google Cloud project to use Vertex AI.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
LIVE_MODEL=              # optional override of the Gemini Live model

# --- Payroll through PhonePe Standard Checkout v2 (optional) ----------------------------------
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=   # stays on the server
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox      # "production" only on purpose
PHONEPE_WEBHOOK_USER=
PHONEPE_WEBHOOK_PASSWORD=

# --- Web app build (optional) -----------------------------------------------------------------
# Only when the web app is hosted apart from the API. Read by `next build`.
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_VOICE_WS_URL=
