# Copy to .env for local use. Never commit real values.

PORT=8080
NODE_ENV=development

# Demo mode lets anyone log in with one click (POST /api/demo-login/:role).
# SET THIS TO false IN PRODUCTION.
DEMO_MODE=true

# Required for real employer login when DEMO_MODE=false. Leave empty to disable.
ADMIN_PASSWORD=

# Where data lives: memory (default, nothing to set up) or firestore (see README, Persistence).
# Firestore uses Application Default Credentials, so no key file or secret goes in this file.
DATA_STORE=memory
# Optional Firestore project id (Cloud Run provides it automatically).
GOOGLE_CLOUD_PROJECT=
# For local emulator runs only, e.g. 127.0.0.1:8681. Leave empty otherwise.
FIRESTORE_EMULATOR_HOST=

# Signs session cookies and QR tokens. If empty, a random value is generated at boot
# (sessions then reset on every restart and differ between instances).
SESSION_SECRET=

# Optional: Gemini summary of anonymous feedback themes. Falls back to a rule-based counter.
GEMINI_API_KEY=
GEMINI_MODEL=
