# ==========================================
# FairShift Environment Configuration Template
# Copy this file to .env: cp .env.example .env
# (No external or third-party API keys are required)
# ==========================================

# Server Port
PORT=8080

# Environment Mode: development | test | production
NODE_ENV=development

# Default Active Industry Sector: construction | college
ACTIVE_INDUSTRY=construction

# Data Storage Adapter: inmemory
DATA_STORE=inmemory

# JWT Session Secret (replace with your own secret string in production)
JWT_SECRET=

# Anonymous Feedback HMAC Pepper (replace with your own secret string in production)
FEEDBACK_SALT=

# API Rate Limit Window (in milliseconds) & Max Requests
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
