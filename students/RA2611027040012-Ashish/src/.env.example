# FairShift environment variables. Copy to .env and fill in what you need.
# Every variable is optional for local development: the app runs with demo data
# and keyword-based triage when nothing is set.

# Secret used to sign login cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Secret that seeds the rotating 4-digit site check-in codes (generate the same way).
SITE_CODE_SECRET=

# Google AI Studio API key for Gemini report triage on hosts outside Google Cloud.
GEMINI_API_KEY=

# Google Cloud project ID. When set, Gemini is called through Vertex AI with the service identity instead of a key.
GOOGLE_CLOUD_PROJECT=

# Vertex AI region used when GOOGLE_CLOUD_PROJECT is set.
GOOGLE_CLOUD_LOCATION=asia-south1

# Gemini model used for triage.
GEMINI_MODEL=gemini-3.5-flash-lite

# Force AI triage on or off (true/false). Defaults to on when a key or project is set.
AI_ENABLED=

# Enables the one-click demo logins on the landing page (true/false).
DEMO_MODE=true

# Mark cookies as Secure. Set to true when served over HTTPS (Cloud Run, Render).
SECURE_COOKIES=false

# Maximum size of an uploaded voice report, in bytes (default 2 MB).
MAX_AUDIO_BYTES=2097152
